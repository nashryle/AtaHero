<?xml version="1.0" encoding="UTF-8"?>
<!-- Ata Hero online update feed. UpdateService reads this on every launch.
     Each release: bump <version> and point <url> at the new setup exe.
     <version> must be > the installed AssemblyVersion to trigger an update.

     !! THE TAG IS CASE-SENSITIVE !!
     GitHub release URLs use the TAG, not the release title, and the tag is
     matched exactly. The tag on GitHub is "V1.0.14" with a CAPITAL V, so
     ".../download/v1.0.14/..." returns 404 and the app reports "Couldn't
     reach the update server". Copy the tag from the release page rather than
     typing it. -->
<item>
  <version>1.0.14.0</version>
  <url>https://github.com/nashryle/AtaHero/releases/download/V1.0.14/AtaHeroSetup-1.0.14.exe</url>
  <changelog>https://github.com/nashryle/AtaHero/releases/tag/V1.0.14</changelog>
  <mandatory mode="0">false</mandatory>
</item>
